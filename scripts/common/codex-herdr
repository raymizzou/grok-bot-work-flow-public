#!/usr/bin/python3
"""Forward the launching Herdr pane's context to Codex shell tools."""
import json
import os
import shutil
import sys

binary = shutil.which("codex")
if not binary:
    sys.exit("codex-herdr: codex is not on PATH")

args = [binary]
if os.environ.get("HERDR_ENV") == "1":
    # The shared daemon ignores new environment overrides for loaded threads.
    args.append("--no-daemon")
    for key in (
        "HERDR_ENV", "HERDR_WORKSPACE_ID", "HERDR_TAB_ID", "HERDR_PANE_ID",
        "HERDR_SOCKET_PATH", "HERDR_BIN_PATH", "HERDR_SESSION", "HERDR_CONFIG_PATH", "PATH",
    ):
        if key in os.environ:
            value = json.dumps(os.environ[key], ensure_ascii=False)
            args.extend(["-c", f"shell_environment_policy.set.{key}={value}"])
os.execv(binary, args + sys.argv[1:])
